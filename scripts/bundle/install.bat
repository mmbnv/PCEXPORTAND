@echo off
REM PortAgent bundle installer (Windows).
REM   install.bat
REM Points PortAgent at the tools\ that ship inside the bundle and writes
REM env.bat. Nothing is installed system-wide and no network is required.
setlocal
set "BUNDLE_DIR=%~dp0"
set "TOOLS=%BUNDLE_DIR%tools"

echo [install] bundle directory: %BUNDLE_DIR%

where python >nul 2>nul
if errorlevel 1 (
    echo [install] WARN: python not found. Install Python 3.10+ and re-run.
    exit /b 1
)

set "NDK_DIR="
for /d %%D in ("%TOOLS%\android-sdk\ndk\*") do set "NDK_DIR=%%D"

(
    echo @echo off
    echo REM Generated by install.bat -- call this before using PortAgent.
    echo set "PAGENT_TOOLS_HOME=%TOOLS%"
    echo set "ANDROID_HOME=%TOOLS%\android-sdk"
    echo set "ANDROID_SDK_ROOT=%%ANDROID_HOME%%"
    if defined NDK_DIR echo set "ANDROID_NDK_HOME=%NDK_DIR%"
    echo set "PATH=%%PAGENT_TOOLS_HOME%%\jadx\bin;%%PATH%%"
    echo set "PYTHONPATH=%BUNDLE_DIR%;%%PYTHONPATH%%"
) > "%BUNDLE_DIR%env.bat"
echo [install] wrote env.bat

echo.
echo [install] checking bundled tools:
if exist "%TOOLS%\android-sdk\build-tools" (echo   OK   Android SDK) else (echo   MISS Android SDK)
if exist "%TOOLS%\android-sdk\platforms"   (echo   OK   android.jar)  else (echo   MISS android.jar)
if exist "%TOOLS%\android-sdk\ndk"         (echo   OK   Android NDK)  else (echo   MISS Android NDK)
if exist "%TOOLS%\jadx"                    (echo   OK   jadx)         else (echo   MISS jadx)
if exist "%TOOLS%\runtime\wine_dxvk"       (echo   OK   Wine/Box64 runtime) else (echo   MISS Wine/Box64 runtime)

echo.
echo [install] complete. Start with: START.bat
endlocal
